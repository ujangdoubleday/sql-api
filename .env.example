# ─── Database ────────────────────────────────────────────────────────────────
# Supported drivers: mysql | postgres | sqlserver
DB_DRIVER=mysql

# MySQL:      user:password@tcp(host:3306)/dbname?parseTime=true
# PostgreSQL: postgres://user:password@host:5432/dbname?sslmode=disable
# SQL Server: sqlserver://user:password@host:1433?database=dbname
DB_DSN=root:secret@tcp(127.0.0.1:3306)/mydb?parseTime=true

# ─── Connection Pool ─────────────────────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Query Execution ─────────────────────────────────────────────────────────
QUERY_TIMEOUT_SECONDS=10


# Optional multi-database mode: uncomment all required settings below.
# DATABASES takes precedence over the legacy DB_DRIVER/DB_DSN above.
# Aliases must match [a-z][a-z0-9_]*; DEFAULT_DATABASE is required in named mode.
# DATABASES=main,reporting
# DEFAULT_DATABASE=main
# DB_MAIN_DRIVER=mysql
# DB_MAIN_DSN="app:example@tcp(mysql.internal:3306)/app?parseTime=true"
# DB_REPORTING_DRIVER=postgres
# DB_REPORTING_DSN="postgres://reporter:example@postgres.internal:5432/reporting?sslmode=require"
# Each pool inherits DB_MAX_* / DB_CONN_MAX_LIFETIME_MINUTES unless overridden.
# DB_REPORTING_MAX_OPEN_CONNS=10
# DB_REPORTING_MAX_IDLE_CONNS=2
# DB_REPORTING_CONN_MAX_LIFETIME_MINUTES=10
